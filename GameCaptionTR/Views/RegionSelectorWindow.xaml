<Window x:Class="GameCaptionTR.Views.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Altyazı Bölgesi Seç"
        WindowStyle="None"
        WindowState="Normal"
        AllowsTransparency="True"
        Background="#66000000"
        Topmost="True"
        Cursor="Cross"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        KeyDown="Window_OnKeyDown"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown"
        MouseMove="Window_OnMouseMove"
        MouseLeftButtonUp="Window_OnMouseLeftButtonUp">
    <Grid>
        <TextBlock Text="Altyazı bölgesini sürükleyerek seç • Esc iptal"
                   Foreground="White"
                   FontSize="22"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,40,0,0"/>
        <Canvas x:Name="CanvasRoot"/>
    </Grid>
</Window>
