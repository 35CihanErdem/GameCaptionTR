<Window x:Class="GameCaptionTR.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameCaptionTR Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Width="900"
        Height="180"
        MinWidth="320"
        MinHeight="100">
    <Border CornerRadius="14"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            Background="#CC101418"
            Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#33FFFFFF"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <TextBlock Text="Çeviri katmanı — sürükleyerek taşı"
                           Foreground="#CCFFFFFF"
                           FontSize="12"
                           Margin="12,6,12,0"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock x:Name="CaptionText"
                       Grid.Row="1"
                       Text="Altyazı çevirisi burada görünecek"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="18"/>
        </Grid>
    </Border>
</Window>
