<Window x:Class="GameCaptionTR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameCaptionTR — Canlı Oyun Altyazı Çevirici"
        Height="620"
        Width="780"
        MinHeight="560"
        MinWidth="700"
        Background="#111827"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E7EB"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#374151"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="GameCaptionTR" FontSize="28" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Steam/Epic oyunlarında ekrandaki altyazıları okur ve Türkçeye çevirir. Oyuna enjekte olmaz; sadece ekran yakalama + Windows OCR kullanır."
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Foreground="#9CA3AF"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1F2937" CornerRadius="12" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                    <TextBlock Text="Kaynak dil (OCR)" Margin="0,0,0,6"/>
                    <ComboBox x:Name="SourceLanguageCombo"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                    <TextBlock Text="Tarama aralığı (ms)" Margin="0,0,0,6"/>
                    <TextBox x:Name="IntervalBox" Text="900"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Yazı boyutu" Margin="0,0,0,6"/>
                    <TextBox x:Name="FontSizeBox" Text="28"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,12,8">
                    <TextBlock Text="Altyazı bölgesi" Margin="0,0,0,6"/>
                    <TextBlock x:Name="RegionText" Text="Henüz seçilmedi" Foreground="#93C5FD"/>
                </StackPanel>

                <CheckBox x:Name="ClickThroughCheck"
                          Grid.Row="1"
                          Grid.Column="2"
                          Content="Tıklamaları oyuna geçir"
                          Foreground="#E5E7EB"
                          VerticalAlignment="Center"/>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="1) Bölge Seç" Click="SelectRegion_Click"/>
                    <Button Content="2) Başlat" x:Name="StartButton" Click="Start_Click" Background="#059669"/>
                    <Button Content="Durdur" x:Name="StopButton" Click="Stop_Click" IsEnabled="False" Background="#DC2626"/>
                    <Button Content="Katmanı Göster" Click="ShowOverlay_Click" Background="#4B5563"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#1F2937" CornerRadius="12" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Nasıl kullanılır" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="#D1D5DB"
                           Text="1) Oyunu aç ve altyazıları aç.&#10;2) 'Bölge Seç' ile altyazının olduğu alanı işaretle.&#x0a;3) 'Başlat'a bas. Çeviri, sürükleyebileceğin şeffaf katmanda görünür.&#x0a;4) Oyun içinde tıklamak için 'Tıklamaları oyuna geçir' seçeneğini aç."/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1F2937" CornerRadius="12" Padding="14" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="OCR (orijinal)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="SourcePreview" TextWrapping="Wrap" Foreground="#FDE68A"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="#1F2937" CornerRadius="12" Padding="14" Margin="8,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Türkçe çeviri" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TranslatedPreview" TextWrapping="Wrap" Foreground="#A7F3D0"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   Margin="0,14,0,0"
                   Text="Hazır. Bölge seçip başlat."
                   Foreground="#93C5FD"/>
    </Grid>
</Window>
