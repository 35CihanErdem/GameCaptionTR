<Window x:Class="GameCaptionTR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameCaptionTR — Canlı Oyun Altyazı Çevirici"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="720"
        Width="780"
        MinHeight="560"
        MinWidth="700"
        Background="#111827"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E7EB"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#374151"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="GameCaptionTR" FontSize="28" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Steam/Epic oyunlarında ekrandaki altyazıları okur ve Türkçeye çevirir. Oyuna enjekte olmaz; sadece ekran yakalama + Windows OCR kullanır."
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Foreground="#9CA3AF"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1F2937" CornerRadius="12" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                    <TextBlock Text="Kaynak dil (OCR)" Margin="0,0,0,6"/>
                    <ComboBox x:Name="SourceLanguageCombo"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                    <TextBlock Text="Çeviri modu" Margin="0,0,0,6"/>
                    <ComboBox x:Name="TranslationModeCombo" SelectionChanged="TranslationModeCombo_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Yazı boyutu" Margin="0,0,0,6"/>
                    <TextBox x:Name="FontSizeBox" Text="28"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                    <TextBlock Text="Tarama aralığı (ms)" Margin="0,0,0,6"/>
                    <TextBox x:Name="IntervalBox" Text="900"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12">
                    <TextBlock Text="Altyazı bölgesi" Margin="0,0,0,6"/>
                    <TextBlock x:Name="RegionText" Text="Henüz seçilmedi" Foreground="#93C5FD"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center">
                    <Button x:Name="DownloadOfflineModelButton"
                            Content="Çevrimdışı modeli indir (~530MB)"
                            Click="DownloadOfflineModel_Click"
                            Padding="10,6"
                            Background="#0D9488"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Left"
                            ToolTip="İnternetsiz oynamak için bir kez indir. İngilizce → Türkçe."/>
                    <TextBlock x:Name="OfflineModelStatusText"
                               Foreground="#6EE7B7"
                               FontSize="12"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Center">
                    <CheckBox x:Name="ClickThroughCheck"
                              Content="Tıklamaları oyuna geçir"
                              Foreground="#E5E7EB"
                              Margin="0,0,0,6"/>
                    <CheckBox x:Name="ShowInCapturesCheck"
                              Content="Kayıtlarda paneli göster (Win+G)"
                              Foreground="#E5E7EB"
                              Margin="0,0,0,6"
                              ToolTip="Açıkken çeviri paneli Win+G / Discord kaydında görünür."/>
                    <CheckBox x:Name="RemoteAccessCheck"
                              Content="Uzak erişim modu (RDP/AnyDesk)"
                              Foreground="#FDE68A"
                              ToolTip="Uzaktan bağlanınca paneli görmek için bunu aç. Panel opak olur ama görünür."/>
                </StackPanel>

                <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                    <Button Content="1) Bölge Seç" Click="SelectRegion_Click"/>
                    <Button Content="2) Başlat" x:Name="StartButton" Click="Start_Click" Background="#059669"/>
                    <Button Content="Durdur" x:Name="StopButton" Click="Stop_Click" IsEnabled="False" Background="#DC2626"/>
                    <Button Content="Katmanı Göster" Click="ShowOverlay_Click" Background="#4B5563"/>
                    <Button Content="Ekranı Çevir (Ctrl+Shift+T)"
                            Click="TranslateScreen_Click"
                            Background="#7C3AED"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#1F2937" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="#92400E" BorderThickness="1">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right"
                            Content="Detaylı bilgi"
                            Click="ShowSafetyDisclaimer_Click"
                            Padding="10,6"
                            Background="#4B5563"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            VerticalAlignment="Top"/>
                    <TextBlock Text="Güvenlik ve ban riski" FontWeight="SemiBold" Foreground="#FBBF24"/>
                </DockPanel>
                <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="#D1D5DB" FontSize="13"
                           Text="Bu araç HİLE DEĞİLDİR; oyuna enjekte olmaz. Hikâye / tek oyunculu oyunlar için tasarlanmıştır (RDR2, Witcher vb.). Rekabetçi online oyunlarda kullanmayın. %100 ban garantisi verilemez — risk sana aittir."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="#1F2937" CornerRadius="12" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Nasıl kullanılır" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="#D1D5DB"
                           Text="1) Oyunu aç ve altyazıları aç.&#10;2) 'Bölge Seç' ile altyazının olduğu alanı işaretle.&#x0a;3) 'Başlat'a bas. Çeviri, sürükleyebileceğin şeffaf katmanda görünür.&#x0a;4) Kitap, broşür veya menü için fareyi ilgili ekrana götürüp Ctrl+Shift+T'ye bas."/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1F2937" CornerRadius="12" Padding="14" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="OCR (orijinal)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="SourcePreview" TextWrapping="Wrap" Foreground="#FDE68A"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="#1F2937" CornerRadius="12" Padding="14" Margin="8,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Türkçe çeviri" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TranslatedPreview" TextWrapping="Wrap" Foreground="#A7F3D0"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="5"
                   Margin="0,14,0,0"
                   Text="Hazır. Bölge seçip başlat."
                   Foreground="#93C5FD"/>
    </Grid>
</Window>
